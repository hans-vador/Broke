# Xcode user data
xcuserdata/
*.xcuserstate

# Build products
DerivedData/
build/

# macOS
.DS_Store

# Large mascot demo recordings (keep local, not in repo)
MascotArt/*.mp4

# Mascot working art: source layers, retired rigs and preview renders.
# The app bundles what it needs from Broke/Assets.xcassets and
# Broke/MascotLottie; these are the large intermediates behind them.
MascotArt/layers/
MascotArt/retired_layered_rig/
**/*.mp4
**/*.gif

# Scratch output from the image tooling
tmp/

# Graphify knowledge graph output. Regenerates deterministically from source
# via `graphify update .`, and the post-commit hook keeps it current, so the
# ~1.8 MB of graph.json + graph.html does not need to live in history.
# To share it across machines instead, drop this line — the union merge driver
# for graph.json is already registered in .git/config.
graphify-out/

# Python bytecode from the mascot tooling
__pycache__/
